<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#05080d">
<title>MOVA TRADING</title>
<link rel="icon" type="image/png" sizes="64x64" href="assets/favicon-64x64.png">
<link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16x16.png">
<link rel="shortcut icon" href="favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">
<link rel="manifest" href="manifest.webmanifest">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="MOVA">

<style>
:root{--bg:#05080d;--panel:#0a141e;--panel2:#07131d;--line:rgba(255,255,255,.075);--line2:rgba(64,187,255,.22);--text:#f5f8fb;--muted:#859aaa;--blue:#42bbff;--blue2:#168dff;--green:#78ef31;--red:#ff6673;--amber:#ffbd59;--header:68px;--ticker:60px}
*{box-sizing:border-box} html{scroll-behavior:auto} body{margin:0;background:radial-gradient(circle at 12% -8%,rgba(22,141,255,.10),transparent 28%),linear-gradient(180deg,#05080d,#07101a 52%,#05080d);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input{font:inherit} button{cursor:pointer} .hidden{display:none!important}
header{position:sticky;top:0;z-index:100;height:var(--header);display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;padding:9px 22px;background:rgba(5,8,13,.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
.brand{border:0;background:none;padding:0} .brand img{width:210px;display:block} nav{display:flex;justify-content:center;gap:5px} nav button{border:0;background:transparent;color:#8499aa;font-weight:850;font-size:12px;padding:10px 13px;border-radius:999px} nav button.active,nav button:hover{color:white;background:#0c1923}
.header-search{width:min(360px,27vw);height:41px;border-radius:14px;border:1px solid var(--line2);background:#07131d;color:white;padding:0 12px}
.ticker{position:sticky;top:var(--header);z-index:90;height:var(--ticker);overflow:hidden;background:rgba(5,8,13,.96);border-bottom:1px solid var(--line);backdrop-filter:blur(18px);-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.live{position:absolute;z-index:4;left:9px;top:50%;transform:translateY(-50%);font-size:7px;font-weight:950;letter-spacing:.13em;color:var(--green);background:#08141c;border:1px solid rgba(120,239,49,.17);padding:5px 7px;border-radius:8px}
.ticker-track{display:flex;width:max-content;height:100%;align-items:center;padding-left:54px;animation:scroll 52s linear infinite} .ticker:hover .ticker-track{animation-play-state:paused} .ticker-group{display:flex;gap:7px;padding-right:7px}
.tick{min-width:155px;padding:7px 11px;border-radius:15px;border:1px solid var(--line);background:linear-gradient(180deg,#0c1721,#08121a)} .tick:hover{border-color:rgba(66,187,255,.35)} .tick small{display:block;color:#718697;font-size:7px;font-weight:900;letter-spacing:.08em;text-transform:uppercase} .tick b{font-size:13px} .tick span{font-size:9px;margin-left:5px}
@keyframes scroll{to{transform:translateX(-50%)}}
.page{display:none;max-width:1430px;margin:0 auto;padding:25px 28px 110px} .page.active{display:block} .eyebrow{display:block;color:#738a9c;font-size:8px;font-weight:950;letter-spacing:.12em;text-transform:uppercase} .section{margin-top:25px}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:12px} .section-head h2{margin:4px 0 0;font-size:27px;letter-spacing:-.035em} .section-head p{margin:0;color:#7d92a2;font-size:10px}
.card{border:1px solid var(--line);background:linear-gradient(180deg,rgba(13,24,34,.96),rgba(7,14,21,.96));border-radius:20px;box-shadow:0 22px 60px rgba(0,0,0,.22)}
.btn{border:1px solid var(--line2);background:#091621;color:#dce8f0;border-radius:12px;padding:9px 12px;font-size:10px;font-weight:900} .btn.primary{border:0;background:linear-gradient(135deg,#168dff,#42bbff);color:#041019} .btn.green{border:0;background:linear-gradient(135deg,#78ef31,#22d77d);color:#041006} .up{color:var(--green)!important} .down{color:var(--red)!important} .amber{color:var(--amber)!important} .blue{color:var(--blue)!important}
/* home */
.home-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.65fr);gap:14px} .hero{padding:27px;position:relative;overflow:hidden} .hero:after{content:"";position:absolute;right:-100px;top:-160px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(66,187,255,.12),transparent 70%);pointer-events:none}
.hero h1{font-size:clamp(38px,5vw,66px);line-height:.96;letter-spacing:-.055em;margin:9px 0 14px} .hero p{max-width:840px;color:#9dafbc;font-size:13px;line-height:1.7} .hero-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.driver-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px} .driver{padding:12px;border:1px solid var(--line);border-radius:15px;background:#07121a} .driver b{display:block;font-size:12px;margin:4px 0} .driver p{margin:0;font-size:9px;line-height:1.5;color:#7e94a4}
.mood{padding:18px} .ring{width:160px;height:160px;margin:8px auto;border-radius:50%;padding:12px;background:conic-gradient(var(--green) 0 68%,rgba(255,255,255,.06) 68%)} .ring-in{width:100%;height:100%;border-radius:50%;background:#07121a;display:grid;place-items:center;text-align:center;border:1px solid var(--line)} .ring-in b{font-size:34px} .ring-in span{display:block;color:#8296a6;font-size:9px}
.mood-row{display:flex;justify-content:space-between;padding:9px 0;border-top:1px solid rgba(255,255,255,.05);font-size:10px} .mood-row span{color:#8398a8}
.two{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:13px} .watch{overflow:hidden} .wh,.wr{display:grid;grid-template-columns:1.35fr .65fr .5fr .85fr;gap:9px;align-items:center} .wh{padding:9px 13px;border-bottom:1px solid var(--line);color:#6f8495;font-size:7px;font-weight:900;text-transform:uppercase} .wr{padding:11px 13px;border-bottom:1px solid rgba(255,255,255,.045);font-size:10px} .wr:last-child{border-bottom:0} .asset{display:flex;align-items:center;gap:9px} .logo{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;background:#0b2130;border:1px solid rgba(66,187,255,.15);font-weight:950} .asset small{display:block;color:#718697;font-size:8px}
.ai-home{padding:16px} .ai-head{display:flex;gap:10px;align-items:center} .ai-dot{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;border:1px solid rgba(66,187,255,.2);background:#092030;font-weight:950;color:#72d7ff} .ai-home p{color:#8498a8;font-size:10px;line-height:1.55}
/* pulse */
.pulse-search{display:flex;gap:8px;max-width:780px} .pulse-search input{flex:1;height:44px;border-radius:14px;border:1px solid var(--line2);background:#061019;color:white;padding:0 13px} .metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px} .metric{padding:15px} .metric small{color:#758b9b;font-size:7px;font-weight:900;text-transform:uppercase} .metric b{display:block;font-size:23px;margin-top:5px}
.pulse-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:13px} .chart{padding:16px} .chart svg{width:100%;height:250px} .breadth{padding:16px} .breadth-item{padding:10px;border-radius:14px;cursor:pointer;border:1px solid transparent} .breadth-item:hover{background:#07131d;border-color:var(--line)} .breadth-top{display:flex;justify-content:space-between;font-size:10px} .bar{height:8px;background:#101f2a;border-radius:999px;overflow:hidden;margin-top:6px} .bar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--blue),var(--green))}
.sector-results{display:none;margin-top:12px} .sector-results.open{display:block} .stock-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px} .stock-card{padding:13px;cursor:pointer} .stock-card:hover{border-color:rgba(66,187,255,.25)} .stock-card strong{font-size:12px} .stock-card small{display:block;color:#74899a;margin-top:3px}
/* learn */
.learn-hero{padding:29px;background:radial-gradient(circle at 84% 10%,rgba(22,141,255,.15),transparent 30%),linear-gradient(145deg,#0a1721,#07111a)} .learn-layout{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:22px;align-items:center} .learn-hero h1{font-size:clamp(40px,5.5vw,72px);line-height:.95;letter-spacing:-.06em;margin:8px 0 12px} .learn-hero p{color:#94a8b7;line-height:1.65;font-size:12px}
.learn-ai{padding:13px;margin-top:16px;border:1px solid rgba(66,187,255,.15);border-radius:17px;background:#07131c} .learn-ai-title{display:flex;align-items:center;gap:9px;margin-bottom:8px} .learn-ai-title b{font-size:11px} .learn-ai-title small{display:block;font-size:8px;color:#758a9c;margin-top:2px} .learn-ai-input{display:flex} .learn-ai-input input{flex:1;min-width:0;height:42px;border-radius:12px 0 0 12px;border:1px solid var(--line2);border-right:0;background:#061019;color:white;padding:0 11px} .learn-ai-input button{border:0;border-radius:0 12px 12px 0;background:var(--blue2);color:white;font-weight:900;padding:0 15px} .chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px} .chips button{border:1px solid var(--line);background:#061019;color:#8196a7;border-radius:999px;padding:6px 8px;font-size:8px}
.learn-visual{height:240px;border:1px solid rgba(66,187,255,.12);border-radius:24px;background:#07131d;overflow:hidden;padding:16px} .learn-visual svg{width:100%;height:100%}
.ai-answer{display:none;margin-top:10px;padding:13px;border-radius:15px;border:1px solid rgba(120,239,49,.12);background:#08151e} .ai-answer.open{display:block} .ai-answer h3{margin:5px 0;font-size:16px} .ai-answer p,.ai-answer li{color:#9aadba;font-size:10px;line-height:1.55}
.learn-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px} .learn-tabs button{border:1px solid var(--line);background:#08131c;color:#8398a8;border-radius:999px;padding:8px 10px;font-size:9px;font-weight:850} .learn-tabs button.active{background:linear-gradient(135deg,#42bbff,#78ef31);color:#041018;border:0}
.learn-panel{display:none} .learn-panel.active{display:block} .paths{display:grid;grid-template-columns:repeat(4,1fr);gap:9px} .path{min-height:170px;padding:15px;cursor:pointer;position:relative} .path:hover{border-color:rgba(66,187,255,.28);transform:translateY(-1px)} .path h3{font-size:15px;margin:9px 0 6px} .path p{font-size:9px;line-height:1.5;color:#8195a5} .path footer{position:absolute;bottom:13px;left:15px;right:15px;display:flex;justify-content:space-between;color:#697e8e;font-size:7px}
.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:9px} .tool{padding:15px} .tool h3{font-size:16px;margin:7px 0} .tool p{font-size:9px;color:#7e93a3} .field{display:grid;gap:4px;margin:7px 0} .field label{color:#718696;font-size:7px;font-weight:900} .field input{height:36px;border-radius:10px;border:1px solid var(--line2);background:#061019;color:white;padding:0 9px} .result{padding:9px;border:1px solid var(--line);background:#061019;border-radius:11px;font-size:9px;color:#9badba;margin-top:8px}
.lesson-view{display:none} .lesson-view.open{display:block} .lesson-view article{max-width:980px;margin:0 auto} .lesson-view h1{font-size:clamp(36px,5vw,64px);line-height:.98;letter-spacing:-.05em} .lesson-view h2{margin-top:26px} .lesson-view p,.lesson-view li{color:#9badba;font-size:12px;line-height:1.7} .visual-aid{margin:14px 0;padding:13px;border:1px solid var(--line);background:#07131d;border-radius:18px} .visual-aid svg{width:100%;height:220px} .visual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px} .mini{padding:10px;border-radius:12px;background:#061019;border:1px solid var(--line)} .mini b{font-size:10px} .mini p{font-size:9px;margin:4px 0 0}
/* portfolio/news */
.port-grid{display:grid;grid-template-columns:1fr .75fr;gap:13px} .balance{padding:18px} .balance strong{display:block;font-size:37px;margin:5px 0} .holdings{overflow:hidden} .hh,.hr{display:grid;grid-template-columns:1.2fr .45fr .6fr .6fr .5fr;gap:8px;align-items:center} .hh{padding:9px 12px;border-bottom:1px solid var(--line);font-size:7px;text-transform:uppercase;color:#6d8292;font-weight:900} .hr{padding:11px 12px;border-bottom:1px solid rgba(255,255,255,.04);font-size:9px} .add{display:grid;grid-template-columns:repeat(4,1fr);gap:7px} .add input{height:39px;border-radius:10px;border:1px solid var(--line2);background:#061019;color:white;padding:0 9px}
.news-head{display:flex;justify-content:space-between;gap:12px;align-items:end} .news-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px} .news-card{display:grid;grid-template-columns:160px 1fr;overflow:hidden;min-height:130px;cursor:pointer} .news-card:hover{border-color:rgba(66,187,255,.28)} .news-img{width:100%;height:100%;object-fit:cover;background:#0a1822} .news-copy{padding:13px} .news-copy h3{font-size:15px;line-height:1.25;margin:6px 0} .news-copy p{color:#8095a5;font-size:9px;line-height:1.45;margin:0} .news-meta{display:flex;gap:8px;margin-top:8px;color:#6f8495;font-size:7px}
/* modal */
.modal{display:none;position:fixed;z-index:500;inset:0;padding:18px;align-items:center;justify-content:center;background:rgba(2,5,8,.78);backdrop-filter:blur(12px)} .modal.open{display:flex} .modal-box{width:min(720px,95vw);max-height:86vh;overflow:auto;background:linear-gradient(180deg,#0d1a24,#07121a);border:1px solid var(--line2);border-radius:21px;padding:20px} .close{float:right;width:34px;height:34px;border-radius:10px;border:1px solid var(--line);background:#061019;color:white} .modal h3{font-size:23px;margin:5px 0 9px} .modal p,.modal li{color:#9badba;font-size:11px;line-height:1.6} .detail{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin:10px 0} .detail div{padding:9px;border:1px solid var(--line);background:#061019;border-radius:12px} .detail span{display:block;font-size:7px;color:#708697;text-transform:uppercase} .detail b{display:block;margin-top:3px;font-size:12px}
.mobile-nav{display:none}
@media(max-width:1000px){.home-grid,.two,.pulse-grid,.learn-layout,.port-grid{grid-template-columns:1fr}.paths{grid-template-columns:repeat(2,1fr)}.tools,.stock-grid{grid-template-columns:repeat(2,1fr)}.news-grid{grid-template-columns:1fr}}
@media(max-width:740px){:root{--header:60px;--ticker:56px} header{grid-template-columns:1fr auto;padding:8px 12px} .brand img{width:150px} nav,.header-search{display:none} .page{padding:17px 12px 90px} .ticker-track{animation-duration:44s} .tick{min-width:140px} .driver-grid,.metrics,.paths,.tools,.stock-grid,.visual-grid{grid-template-columns:1fr} .wh,.wr{grid-template-columns:1.3fr .7fr .55fr} .wh>*:nth-child(4),.wr>*:nth-child(4){display:none} .hh,.hr{grid-template-columns:1.2fr .45fr .6fr} .hh>*:nth-child(4),.hh>*:nth-child(5),.hr>*:nth-child(4),.hr>*:nth-child(5){display:none} .add{grid-template-columns:1fr 1fr} .news-card{grid-template-columns:115px 1fr} .section-head p{display:none} .learn-hero{padding:20px} .learn-hero h1{font-size:43px} .mobile-nav{display:grid;position:fixed;z-index:120;left:0;right:0;bottom:0;grid-template-columns:repeat(5,1fr);padding:6px 6px max(6px,env(safe-area-inset-bottom));background:rgba(5,8,13,.96);border-top:1px solid var(--line)} .mobile-nav button{border:0;background:none;color:#74899a;font-size:8px;padding:6px 2px} .mobile-nav button.active{color:white}}

/* V2.1 feature expansion */
.ticker-toggle{
  position:absolute;z-index:5;left:58px;top:50%;transform:translateY(-50%);
  display:flex;gap:2px;padding:3px;border:1px solid var(--line);border-radius:10px;
  background:rgba(6,16,25,.94);backdrop-filter:blur(10px)
}
.ticker-toggle button{border:0;background:transparent;color:#718697;border-radius:7px;padding:5px 8px;font-size:7px;font-weight:900}
.ticker-toggle button.active{background:#123047;color:#fff}
.ticker-track{padding-left:205px}
.catalyst-detail{padding:16px}
.catalyst-badge{padding:6px 9px;border:1px solid rgba(120,239,49,.18);border-radius:999px;background:rgba(120,239,49,.045);color:var(--green);font-size:7px;font-weight:950;letter-spacing:.08em}
.catalyst-network{display:grid;grid-template-columns:1fr 34px 1fr 34px 1fr;gap:7px;align-items:stretch}
.cnode{padding:11px;border-radius:14px;background:#061019;border:1px solid var(--line)}
.cnode span{display:block;color:#6f8495;font-size:6px;font-weight:950;letter-spacing:.1em}
.cnode b{display:block;margin:4px 0;font-size:11px}.cnode small{display:block;color:#8297a7;font-size:8px;line-height:1.4}
.cnode.source{border-color:rgba(66,187,255,.14)}.cnode.effect{border-color:rgba(255,189,89,.13)}.cnode.outcome{border-color:rgba(120,239,49,.13)}
.carrow{display:grid;place-items:center;color:#557184;font-size:17px;font-weight:900}
.catalyst-visual{margin-top:12px;padding:12px 13px;border-radius:15px;background:#061019;border:1px solid var(--line)}
.cv-labels{display:flex;justify-content:space-between;color:#61798b;font-size:6px;font-weight:900;letter-spacing:.08em}
.cv-track{position:relative;height:8px;margin:8px 0;border-radius:999px;background:linear-gradient(90deg,#ff6673,#ffbd59,#42bbff,#78ef31)}
.cv-track i{position:absolute;top:50%;width:18px;height:18px;border:3px solid #fff;border-radius:50%;background:#07131d;transform:translate(-50%,-50%);box-shadow:0 0 0 4px rgba(66,187,255,.10)}
.cv-note{color:#8da2b2;font-size:8px}.cv-note b{color:#fff}
.portfolio-pie-wrap{display:grid;grid-template-columns:170px 1fr;gap:16px;align-items:center}
.portfolio-pie{width:165px;height:165px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#42bbff 0 100%);position:relative}
