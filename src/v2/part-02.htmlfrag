.portfolio-pie:before{content:"";position:absolute;inset:31px;border-radius:50%;background:#08131c;border:1px solid var(--line)}
.portfolio-pie>div{position:relative;z-index:1;text-align:center}.portfolio-pie b{display:block;font-size:16px}.portfolio-pie span{font-size:7px;color:#718697}
.portfolio-legend{display:grid;gap:7px}.portfolio-legend-row{display:grid;grid-template-columns:9px 1fr auto;gap:7px;align-items:center;font-size:9px}
.portfolio-legend-row i{width:9px;height:9px;border-radius:3px}.portfolio-legend-row span{color:#8ba0af}.portfolio-legend-row b{font-size:9px}
.news-search-wrap{margin-top:13px;padding:13px;border:1px solid rgba(66,187,255,.14);border-radius:17px;background:#07131d}
.news-search-row{display:flex;gap:7px;margin-top:7px}.news-search-row input{flex:1;min-width:0;height:41px;border:1px solid var(--line2);border-radius:12px;background:#061019;color:#fff;padding:0 11px}
.news-search-summary{display:none;margin-top:9px;color:#8ca1b0;font-size:9px;line-height:1.5}.news-search-summary.open{display:block}
.news-impact{margin-top:8px;padding:8px 9px;border-radius:10px;background:#061019;border-left:3px solid var(--blue);font-size:8px;color:#91a6b5;line-height:1.45}
.news-impact b{color:#fff}
.top-button{position:fixed;z-index:2147483000;right:20px;bottom:24px;display:none;align-items:center;gap:6px;border:1px solid rgba(66,187,255,.27);background:rgba(7,19,29,.94);color:#fff;backdrop-filter:blur(14px);border-radius:999px;padding:9px 12px;font-size:9px;font-weight:900;box-shadow:0 12px 40px rgba(0,0,0,.42),0 0 0 1px rgba(66,187,255,.06)}
.top-button.show{display:flex}
.study-block{margin-top:22px}.study-block h2{font-size:24px;margin-bottom:9px}
.study-explain-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.study-explain{padding:12px;border:1px solid var(--line);border-radius:14px;background:#061019}
.study-explain b{font-size:10px}.study-explain p{margin:5px 0 0!important;font-size:9px!important;line-height:1.55!important}
.study-compare{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.study-compare>div{padding:12px;border-radius:14px;border:1px solid var(--line);background:#07131d}
.study-check{display:grid;gap:6px;margin-top:8px}.study-check div{padding:9px 10px;border-radius:11px;background:#061019;border:1px solid var(--line);font-size:9px;color:#8fa4b4}
@media(max-width:740px){
  .ticker-toggle{left:49px}.ticker-toggle button{padding:5px 6px}.ticker-track{padding-left:180px}
  .catalyst-network{grid-template-columns:1fr}.carrow{height:18px;transform:rotate(90deg)}
  .portfolio-pie-wrap{grid-template-columns:1fr}.portfolio-pie{margin:auto}
  .news-search-row{display:grid;grid-template-columns:1fr auto}.news-search-row .btn:last-child{grid-column:1/-1}
  .study-explain-grid,.study-compare{grid-template-columns:1fr}
  .top-button{right:12px;bottom:78px}
}


/* Pulse company research expansion */
.breadth-full{padding:18px}
.breadth-full #breadthList{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:12px
}
.breadth-full .breadth-item{
  padding:13px;border:1px solid var(--line);background:#07131d;border-radius:15px
}
.breadth-full .sector-results{margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}
.breadth-full .stock-grid{grid-template-columns:repeat(5,minmax(0,1fr))}
.pulse-company-card{cursor:pointer;transition:.18s}
.pulse-company-card:hover{border-color:rgba(66,187,255,.32);transform:translateY(-1px)}
.company-card-hint{margin-top:10px;color:#6f8ea5;font-size:8px;font-weight:850}
.company-research-view{
  display:none;position:relative;max-width:1430px;margin:0 auto;padding:25px 28px 110px
}
.company-research-view.open{display:block}
.company-research-shell{display:grid;gap:14px}
.company-research-hero{
  display:grid;grid-template-columns:1fr auto;gap:18px;align-items:end;padding:22px 0 5px
}
.company-research-hero h1{font-size:clamp(42px,6vw,78px);line-height:.95;letter-spacing:-.06em;margin:7px 0 10px}
.company-research-hero p{max-width:820px;color:#94a9b8;font-size:12px;line-height:1.65}
.cr-price-card{min-width:210px;padding:16px;border-radius:18px;border:1px solid var(--line);background:#07131d;text-align:right}
.cr-price-card span{display:block;color:#72889a;font-size:7px;font-weight:900;text-transform:uppercase}
.cr-price-card b{display:block;font-size:28px;margin:4px 0}.cr-price-card small{font-size:11px}
.cr-tabs{display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:10px}
.cr-tabs button{border:1px solid var(--line);background:#08131d;color:#8197a7;border-radius:999px;padding:8px 10px;font-size:9px;font-weight:850}
.cr-tabs button.active{background:linear-gradient(135deg,#42bbff,#78ef31);color:#041018;border:0}
.cr-panel{display:none}.cr-panel.active{display:block}
.cr-grid{display:grid;gap:10px;margin:10px 0}.cr-grid.two-up{grid-template-columns:repeat(2,1fr)}.cr-grid.three-up{grid-template-columns:repeat(3,1fr)}.cr-grid.four-up{grid-template-columns:repeat(4,1fr)}
.cr-card{padding:16px}.cr-card h3{font-size:18px;margin:7px 0}.cr-card p,.cr-card li{color:#91a6b5;font-size:10px;line-height:1.6}
.cr-card ul{padding-left:17px;margin-bottom:0}
.cr-fact{padding:13px;border:1px solid var(--line);background:#07131d;border-radius:15px}
.cr-fact span{display:block;color:#718697;font-size:7px;font-weight:900;text-transform:uppercase}
.cr-fact b{display:block;margin-top:5px;font-size:14px}
.business-mix{display:grid;gap:9px;margin-top:12px}
.mix-row{display:grid;grid-template-columns:130px 1fr 46px;gap:10px;align-items:center;font-size:9px}
.mix-row span{color:#899ead}.mix-bar{height:9px;border-radius:999px;background:#101f2a;overflow:hidden}.mix-bar i{display:block;height:100%;background:linear-gradient(90deg,#42bbff,#78ef31);border-radius:inherit}
.cr-chart{padding:10px;border:1px solid var(--line);background:#061019;border-radius:16px;margin-top:10px}.cr-chart svg{width:100%;height:280px}
.timeline{display:grid;gap:9px;margin-top:10px}.timeline-item{display:grid;grid-template-columns:95px 16px 1fr;gap:9px;align-items:start}.timeline-item time{color:#718697;font-size:8px}.timeline-dot{width:10px;height:10px;border-radius:50%;background:#42bbff;margin-top:3px;box-shadow:0 0 0 4px rgba(66,187,255,.08)}.timeline-item p{margin:0!important}
.financial-bars{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;align-items:end;height:230px;margin-top:12px}
.fbar-wrap{text-align:center;height:100%;display:flex;flex-direction:column;justify-content:flex-end}.fbar{margin:auto auto 6px;width:54px;border-radius:11px 11px 4px 4px;background:linear-gradient(180deg,#42bbff,#168dff);min-height:20px}.fbar-wrap small{color:#728899;font-size:7px}.fbar-wrap b{font-size:9px}
.payout-timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.payout-box{padding:11px;border:1px solid var(--line);background:#061019;border-radius:13px}.payout-box span{display:block;color:#718697;font-size:7px}.payout-box b{display:block;margin-top:4px;font-size:11px}
@media(max-width:1050px){
  .breadth-full #breadthList{grid-template-columns:repeat(2,1fr)}
  .breadth-full .stock-grid{grid-template-columns:repeat(3,1fr)}
  .cr-grid.four-up{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:740px){
  .breadth-full #breadthList,.breadth-full .stock-grid,.cr-grid.two-up,.cr-grid.three-up,.cr-grid.four-up{grid-template-columns:1fr}
  .company-research-view{padding:17px 12px 90px}
  .company-research-hero{grid-template-columns:1fr}.cr-price-card{text-align:left;min-width:0}
  .financial-bars{gap:7px}.fbar{width:38px}
  .payout-timeline{grid-template-columns:1fr 1fr}
}


/* V2.3 research readability + interactive market chart */
.company-research-view{font-size:16px}
.company-research-hero p{font-size:15px;line-height:1.72;max-width:940px}.company-research-hero h1{margin-bottom:14px}
.company-research-view .eyebrow{font-size:9px}.cr-tabs button{font-size:11px;padding:10px 13px}.cr-card{padding:20px}.cr-card h3{font-size:22px}.cr-card p,.cr-card li{font-size:13px;line-height:1.7}
.cr-fact span{font-size:9px}.cr-fact b{font-size:16px}.mix-row{font-size:12px}.timeline-item time{font-size:11px}.timeline-item p{font-size:13px!important}.cr-price-card span{font-size:9px}.cr-price-card b{font-size:34px}.cr-price-card small{font-size:13px}
.market-workspace{padding:18px}.market-toolbar-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.market-toolbar-head h3{margin:5px 0 6px}.market-toolbar-head p{margin:0;max-width:760px}
.market-status{min-width:170px;text-align:right;padding:11px 13px;border:1px solid var(--line);border-radius:14px;background:#061019}.market-status span{display:block;color:#718697;font-size:8px;text-transform:uppercase;font-weight:900}.market-status b{display:block;font-size:20px;margin-top:4px}.market-status small{font-size:11px}
.chart-toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:16px 0 10px}.tool-group{display:flex;align-items:center;gap:4px;padding:5px;border:1px solid var(--line);background:#061019;border-radius:12px}.tool-group>span{color:#708697;font-size:8px;font-weight:900;text-transform:uppercase;padding:0 5px}.tool-group button{border:0;background:transparent;color:#8198a8;border-radius:8px;padding:7px 8px;font-size:9px;font-weight:850}.tool-group button:hover,.tool-group button.active{background:#123047;color:#fff}
.chart-shell{position:relative;border:1px solid var(--line);border-radius:17px;background:#050e15;overflow:hidden}.chart-shell canvas{width:100%;height:520px;display:block;cursor:crosshair}.chart-hint{position:absolute;left:12px;bottom:10px;padding:6px 8px;border-radius:8px;background:rgba(5,14,21,.84);border:1px solid var(--line);color:#718697;font-size:8px;pointer-events:none}
.rsi-panel{margin-top:8px;border:1px solid var(--line);border-radius:14px;background:#050e15;overflow:hidden}.rsi-panel canvas{display:block;width:100%;height:150px}.chart-stats{display:grid;grid-template-columns:repeat(6,1fr);gap:7px;margin-top:9px}.chart-stat{padding:10px;border:1px solid var(--line);border-radius:12px;background:#061019}.chart-stat span{display:block;color:#708697;font-size:7px;font-weight:900;text-transform:uppercase}.chart-stat b{display:block;margin-top:4px;font-size:12px}
@media(max-width:900px){.chart-stats{grid-template-columns:repeat(3,1fr)}}
@media(max-width:740px){.company-research-view{font-size:15px}.company-research-hero p{font-size:14px}.cr-card p,.cr-card li{font-size:12px}.market-toolbar-head{display:block}.market-status{margin-top:10px;text-align:left}.tool-group{width:100%;overflow-x:auto}.tool-group>span{min-width:max-content}.tool-group button{white-space:nowrap}.chart-shell canvas{height:390px}.chart-stats{grid-template-columns:repeat(2,1fr)}}


.tool-help-btn{min-width:28px!important;width:28px;height:28px;padding:0!important;border:1px solid rgba(66,187,255,.24)!important;background:#0a2434!important;color:#74d4ff!important;border-radius:50%!important;font-size:11px!important}
.chart-learning-panel{margin-top:14px;padding:16px;border-radius:17px;border:1px solid rgba(66,187,255,.12);background:#07131d}
.chart-learning-head{display:flex;justify-content:space-between;gap:14px;align-items:end}
.chart-learning-head h3{font-size:20px;margin:5px 0 0}
.chart-guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:12px}
.chart-guide-card{text-align:left;padding:12px;border:1px solid var(--line);border-radius:14px;background:#061019;color:#fff;transition:.18s}
.chart-guide-card:hover{border-color:rgba(66,187,255,.3);transform:translateY(-1px)}
.chart-guide-card span{display:block;color:#6fcfff;font-size:8px;font-weight:950;letter-spacing:.08em;text-transform:uppercase}
.chart-guide-card b{display:block;font-size:11px;margin:4px 0}
.chart-guide-card small{display:block;color:#7f95a5;font-size:9px;line-height:1.45}
.chart-help-detail{display:none;margin-top:10px;padding:14px;border-radius:15px;border:1px solid rgba(120,239,49,.12);background:linear-gradient(180deg,#081620,#061019)}
.chart-help-detail.open{display:block}
.chart-help-detail h4{font-size:17px;margin:5px 0 8px}
.chart-help-detail p,.chart-help-detail li{color:#94a9b8;font-size:11px;line-height:1.65}
.chart-help-detail ul{margin:7px 0 0;padding-left:18px}
.chart-help-example{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:11px}
.chart-help-example div{padding:10px;border-radius:12px;border:1px solid var(--line);background:#050e15}
.chart-help-example span{display:block;color:#718697;font-size:7px;font-weight:900;text-transform:uppercase}
.chart-help-example b{display:block;margin-top:4px;font-size:10px}
@media(max-width:900px){.chart-guide-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:740px){.chart-guide-grid,.chart-help-example{grid-template-columns:1fr}.chart-learning-head{display:block}.chart-learning-head .btn{margin-top:8px}}


/* V2.3.3 chart responsiveness */
.active-indicator-legend{
  min-height:26px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  margin:3px 0 8px;color:#708697;font-size:8px
}
.indicator-pill{
  display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:999px;
  border:1px solid var(--line);background:#061019;color:#dce8f0;font-weight:850
}
.indicator-pill i{width:8px;height:8px;border-radius:50%;display:block}
.indicator-pill.sma i{background:#ffbd59}
.indicator-pill.ema i{background:#a98cff}
.indicator-pill.rsi i{background:#42bbff}
.chart-shell.busy:after{
  content:"Updating chart…";position:absolute;right:12px;top:10px;
  padding:5px 8px;border-radius:8px;background:rgba(5,14,21,.88);
  border:1px solid var(--line);color:#8da3b2;font-size:8px
}

</style>
</head>
<body>
<header>
<button class="brand" onclick="go('home')"><img src="assets/MOVA-header-wordmark-text-only-transparent-FIXED.png" alt="MOVA TRADING"></button>
<nav>
<button data-nav="home" class="active" onclick="go('home')">Home</button>
<button data-nav="pulse" onclick="go('pulse')">Pulse</button>
<button data-nav="learn" onclick="go('learn')">Learn</button>
<button data-nav="portfolio" onclick="go('portfolio')">Portfolio</button>
<button data-nav="news" onclick="go('news')">News & Alerts</button>
</nav>
<input id="headerSearch" class="header-search" placeholder="Search MOVA — ticker, topic, lesson…" onkeydown="if(event.key==='Enter')headerSearchGo()">
</header>
<div class="ticker">
  <span class="live">LIVE</span>
  <div class="ticker-toggle" role="group" aria-label="Ticker feed">
    <button id="tickerTrendingBtn" class="active" onclick="setTickerMode('trending')">Trending</button>
    <button id="tickerWatchBtn" onclick="setTickerMode('watchlist')">Watchlist</button>
  </div>
  <div id="tickerTrack" class="ticker-track"></div>
</div>

<main id="home" class="page active">
  <section class="home-grid">
    <div class="card hero">
      <span class="eyebrow">TODAY IN THE MARKETS</span>
      <h1>Momentum is positive.<br>Chasing it is optional.</h1>
      <p>Technology leadership and softer yields are helping risk appetite, while oil weakness is keeping part of the inflation pressure contained. Breadth is healthy, but several growth names are extended after strong runs.</p>
      <div class="hero-actions">
        <button class="btn primary" onclick="go('pulse')">Open market pulse →</button>
        <button class="btn" onclick="go('learn');prefillLearn('Why do bond yields affect Nasdaq stocks?')">Learn what’s driving this →</button>
        <button class="btn" onclick="toggleCatalyst()">View catalyst map →</button>
      </div>
      <div id="catalyst" class="section hidden">
        <div class="card catalyst-detail">
          <div class="section-head" style="margin-bottom:10px">
            <div><span class="eyebrow">CATALYST MAP</span><h2 style="font-size:20px">How today’s drivers are feeding through the market</h2></div>
            <span class="catalyst-badge">NET: CONSTRUCTIVE / SELECTIVE</span>
          </div>
          <div class="catalyst-network">
            <div class="cnode source"><span>MACRO INPUT</span><b>US 10Y ↓ 3bp</b><small>Softer long-term yield</small></div>
            <div class="carrow">→</div>
            <div class="cnode effect"><span>VALUATION</span><b class="up">Pressure eases</b><small>Growth cashflows discounted less heavily</small></div>
            <div class="carrow">→</div>
            <div class="cnode outcome"><span>MARKET EFFECT</span><b class="blue">Nasdaq supported</b><small>Especially long-duration tech</small></div>

            <div class="cnode source"><span>SECTOR INPUT</span><b>AI / semis breadth ↑</b><small>More chip names participating</small></div>
            <div class="carrow">→</div>
            <div class="cnode effect"><span>PARTICIPATION</span><b class="up">Breadth improves</b><small>Less reliance on one mega-cap leader</small></div>
            <div class="carrow">→</div>
            <div class="cnode outcome"><span>MARKET EFFECT</span><b class="up">Momentum healthier</b><small>Trend has broader confirmation</small></div>

            <div class="cnode source"><span>COMMODITY INPUT</span><b>WTI ↓ 0.6%</b><small>Energy prices soften</small></div>
            <div class="carrow">→</div>
            <div class="cnode effect"><span>INFLATION</span><b class="amber">Pressure cools</b><small>One inflation component becomes less restrictive</small></div>
            <div class="carrow">→</div>
            <div class="cnode outcome"><span>MARKET EFFECT</span><b class="blue">Rates backdrop helps</b><small>But energy stocks can lag</small></div>
          </div>
          <div class="catalyst-visual">
            <div class="cv-labels"><span>DEFENSIVE</span><span>MIXED</span><span>CONSTRUCTIVE</span><span>RISK-ON</span></div>
            <div class="cv-track"><i style="left:68%"></i></div>
            <div class="cv-note"><b>68 / 100</b> — supportive backdrop, but stretched growth names make entry quality more selective.</div>
          </div>
        </div>
      </div>
